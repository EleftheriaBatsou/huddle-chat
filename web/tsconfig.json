{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": { "@shared/*": ["../shared/*"] },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../shared/**/*.ts"]
}
